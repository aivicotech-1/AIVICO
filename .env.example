# ─────────────────────────────────────────────────────────────────
# AIVICO API — Environment Variables
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────

# The email address where all contact inquiries are delivered
INBOX_EMAIL=hello@aivico.com

# ─── Gmail SMTP (recommended) ─────────────────────────────────────
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Create an App Password for "Mail" on "Other (AIVICO)"
# 3. Paste the 16-character app password below (NOT your Gmail login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password

# ─── Server port (optional) ───────────────────────────────────────
PORT=3001
